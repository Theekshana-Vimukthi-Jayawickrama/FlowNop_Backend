# Server configuration
PORT=5000

# Database configuration
MONGO_URI=mongodb://localhost:27017/taskflow

# Security configurations
JWT_SECRET=supersecretjwtsecretkeytaskflow2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=supersecretrefreshjwtsecretkeytaskflow2026
JWT_REFRESH_EXPIRES_IN=7d

# Cors configuration
CLIENT_URL=http://localhost:5173

# SMTP Mail configurations (Optional locally, falls back to console logs)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="TaskFlow <no-reply@taskflow.com>"
