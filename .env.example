# Server configuration
PORT=5000

# Database configuration
MONGO_URI=mongodb://localhost:27017/taskflow

# Security configurations
JWT_SECRET=supersecretjwtsecretkeytaskflow2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=supersecretrefreshjwtsecretkeytaskflow2026
JWT_REFRESH_EXPIRES_IN=7d

# Cors configuration
CLIENT_URL=http://localhost:5173

# Brevo (formerly Sendinblue) Email configuration (Optional locally, falls back to console simulation)
# Dual-mode support:
# - REST API key (starts with 'xkeysib-') -> uses HTTP REST API on port 443 (Recommended for Render)
# - SMTP Relay -> set BREVO_SMTP_PASSWORD (or use a BREVO_API_KEY that starts with 'xsmtpsib-')
BREVO_EMAIL_MODE=api
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL="FlowNop <your-verified-brevo-sender-email@gmail.com>"
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASSWORD=your-brevo-smtp-relay-key
