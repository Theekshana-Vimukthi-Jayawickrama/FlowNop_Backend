# Server configuration
PORT=5000

# Database configuration
MONGO_URI=mongodb://localhost:27017/taskflow

# Security configurations
JWT_SECRET=supersecretjwtsecretkeytaskflow2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=supersecretrefreshjwtsecretkeytaskflow2026
JWT_REFRESH_EXPIRES_IN=7d

# Cors configuration
CLIENT_URL=http://localhost:5173

# Brevo (formerly Sendinblue) Email configuration (Optional locally, falls back to console simulation)
# Dual-mode support:
# - REST API key (starts with 'xkeysib-') -> uses HTTP REST API on port 443 (Recommended, bypasses port blocking)
# - SMTP Relay key (starts with 'xsmtpsib-') -> uses SMTP relay on port 587
BREVO_API_KEY=your-brevo-api-or-smtp-key
BREVO_SENDER_EMAIL="FlowNop <your-verified-brevo-sender-email@gmail.com>"
